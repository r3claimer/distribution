@@ -0,0 +1,1008 @@
+From deae82762fe83e6dcfda215a495c15577ce57f14 Mon Sep 17 00:00:00 2001
+From: Gianni Spadoni <me@gio.blue>
+Date: Fri, 23 Jan 2026 03:50:07 +0800
+Subject: [PATCH 09/20] arm64: dts: qcom: Enable display on Ayn Odin 3
+
+(This commit fixes tab sizing for sm8750-ayn-odin3.dts)
+
+This is a bit buggy sometimes and might fail every once in a while on boot
+
+This adds a panel driver for the Chipone ICNA3520, the AMOLED panel used in the Odin 3
+
+This also adds the MDSS subsystem and all components needed to drive the display (DisplayPort is excluded for now)
+
+Signed-off-by: Gianni Spadoni <me@gio.blue>
+---
+ arch/arm64/boot/dts/qcom/sm8750-ayn-odin3.dts |  98 +++-
+ arch/arm64/boot/dts/qcom/sm8750-mdss.dtsi     | 450 ++++++++++++++++++
+ drivers/gpu/drm/panel/Kconfig                 |  10 +
+ drivers/gpu/drm/panel/Makefile                |   1 +
+ .../gpu/drm/panel/panel-chipone-icna3520.c    | 355 ++++++++++++++
+ 5 files changed, 912 insertions(+), 2 deletions(-)
+ create mode 100644 arch/arm64/boot/dts/qcom/sm8750-mdss.dtsi
+ create mode 100644 drivers/gpu/drm/panel/panel-chipone-icna3520.c
+
+diff --git a/arch/arm64/boot/dts/qcom/sm8750-ayn-odin3.dts b/arch/arm64/boot/dts/qcom/sm8750-ayn-odin3.dts
+index d7fb2f6b2..ae48e205b 100644
+--- a/arch/arm64/boot/dts/qcom/sm8750-ayn-odin3.dts
++++ b/arch/arm64/boot/dts/qcom/sm8750-ayn-odin3.dts
+@@ -21,6 +21,7 @@
+ #include "pmk8550.dtsi"
+ #include "pmr735d_a.dtsi"
+ #include "sm8750-pmics.dtsi"
++#include "sm8750-mdss.dtsi"
+ 
+ / {
+ 	model = "Ayn Odin 3";
+@@ -101,8 +102,9 @@ linux,cma {
+ 
+ 	pmic-glink {
+ 		compatible = "qcom,sm8750-pmic-glink",
+-					 "qcom,sm8550-pmic-glink",
+-					 "qcom,pmic-glink";
++			     "qcom,sm8550-pmic-glink",
++			     "qcom,pmic-glink";
++		
+ 		#address-cells = <1>;
+ 		#size-cells = <0>;
+ 		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+@@ -152,6 +154,20 @@ vph_pwr: vph-pwr-regulator {
+ 		regulator-always-on;
+ 		regulator-boot-on;
+ 	};
++
++	display_pwr: display-gpio-regulator {
++		compatible = "regulator-fixed";
++
++		regulator-name = "display_panel_avdd";
++		regulator-min-microvolt = <5500000>;
++		regulator-max-microvolt = <5500000>;
++		regulator-enable-ramp-delay = <233>;
++
++		gpio = <&pm8550_gpios 11 GPIO_ACTIVE_HIGH>;
++
++		enable-active-high;
++		regulator-boot-on;
++	};
+ };
+ 
+ &apps_rsc {
+@@ -687,6 +703,41 @@ &uart7 {
+ &tlmm {
+ 	/* reserved for secure world */
+ 	gpio-reserved-ranges = <36 4>, <74 1>;
++
++	disp0_reset_n_active: disp0-reset-n-active-state {
++		pins = "gpio98";
++		function = "gpio";
++		drive-strength = <8>;
++		bias-disable = <0>;
++	};
++
++	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
++		pins = "gpio98";
++		function = "gpio";
++		drive-strength = <2>;
++		bias-pull-down;
++	};
++
++	disp0_mipi_vdd_active: disp0-mipi-vdd-active-state {
++		pins = "gpio97";
++		function = "gpio";
++		drive-strength = <8>;
++		bias-disable = <0>;
++	};
++
++	disp0_mipi_vdd_suspend: disp0-mipi-vdd-suspend-state {
++		pins = "gpio97";
++		function = "gpio";
++		drive-strength = <2>;
++		bias-pull-down;
++	};
++
++	disp0_mdp_vsync: disp0-mdp-vsync-active-state {
++		pins = "gpio86";
++		function = "mdp_vsync";
++		drive-strength = <2>;
++		bias-pull-down;
++	};
+ };
+ 
+ /* Disabled features */
+@@ -790,4 +841,47 @@ &pmih0108_eusb2_repeater {
+ 
+ 	vdd18-supply = <&vreg_l15b_1p8>; // pm-humu-l15
+ 	vdd3-supply = <&vreg_l5b_3p1>; // pm-humu-l5
++};
++
++/* MDSS */
++&mdss {
++	status = "okay";
++};
++
++&mdss_dsi0 {
++	status = "okay";
++	
++	vdda-supply = <&vreg_l3g_1p2>;
++
++	display_panel: panel@0 {
++		reg = <0>;
++		compatible = "chipone,icna3520";
++		
++		vddio-supply = <&vreg_l12b_1p8>;
++		vci-supply = <&vreg_l13b_3p0>;
++		vdd-supply = <&vreg_l11b_1p0>;
++		
++		rotation = <90>;
++		
++		reset-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
++		pinctrl-0 = <&disp0_reset_n_active>, <&disp0_mipi_vdd_active>, <&disp0_mdp_vsync>;
++		pinctrl-1 = <&disp0_reset_n_suspend>, <&disp0_mipi_vdd_suspend>, <&disp0_mdp_vsync>;
++		pinctrl-names = "default", "sleep";
++
++		port {
++			panel0_in: endpoint {
++				remote-endpoint = <&mdss_dsi0_out>;
++			};
++		};
++	};
++};
++
++&mdss_dsi0_out {
++	remote-endpoint = <&panel0_in>;
++	data-lanes = <0 1 2 3>;
++};
++
++&mdss_dsi0_phy {
++	status = "okay";
++	vdds-supply = <&vreg_l3i_0p88>;
+ };
+\ No newline at end of file
