diff --git a/projects/ROCKNIX/devices/SM8750/patches/linux/0015-drm-msm-adreno-Add-support-for-the-Adreno-830.patch b/projects/ROCKNIX/devices/SM8750/patches/linux/0015-drm-msm-adreno-Add-support-for-the-Adreno-830.patch
