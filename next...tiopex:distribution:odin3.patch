+ 	volume_up_n: volume-up-n-state {
+ 		pins = "gpio6";
+ 		function = "normal";
+-		bias-pull-up;
+ 		input-enable;
++		bias-pull-up;
+ 		power-source = <1>;
+ 	};
+ };
+@@ -988,4 +989,25 @@ &mdss_dsi0_out {
+ &mdss_dsi0_phy {
+ 	status = "okay";
+ 	vdds-supply = <&vreg_l3i_0p88>;
++};
++
++/* GPU */
++&gpu {
++	status = "okay";
++};
++
++&gmu {
++	status = "okay";
++};
++
++&gpucc {
++	status = "okay";
++};
++
++&gxcc {
++	status = "okay";
++};
++
++&gpu_zap_shader {
++	firmware-name = "qcom/sm8750/gen80000_zap.mbn";
+ };
+\ No newline at end of file
