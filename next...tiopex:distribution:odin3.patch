+@@ -700,10 +701,43 @@ &uart7 {
+ 	status = "okay";
+ };
+ 
++&qup_i2c4_data_clk {
++	/* Use internal I2C pull-up */
++	bias-pull-up = <2200>;
++};
++
++&i2c4 {
++	status = "okay";
++
++	clock-frequency = <400000>;
++
++	// i2c@a90000 / focaltech@38
