diff --git a/projects/ROCKNIX/devices/SM8750/patches/linux/0009-arm64-dts-qcom-Enable-display-on-Ayn-Odin-3.patch b/projects/ROCKNIX/devices/SM8750/patches/linux/0009-arm64-dts-qcom-Enable-display-on-Ayn-Odin-3.patch
