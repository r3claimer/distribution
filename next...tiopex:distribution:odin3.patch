++		drive-strength = <8>;
++		bias-pull-up;
++	};
++
++	// pmx_ts_release / ts_release
++	ts_reset_default: ts-reset-default-state {
++		pins = "gpio161";
++		function = "gpio";
++		drive-strength = <2>;
++		bias-disable;
++	};
+ };
+ 
+ /* Disabled features */
