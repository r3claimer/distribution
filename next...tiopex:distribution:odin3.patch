+WideScreen = false
+Stretch = false
+WideBackground = false
+XResolution = 1920
+YResolution = 1080
+Fullscreen = 1
+ForceFeedback = 1
+Throttle = 1
+
+; Refresh rate (milliHertz accuracy). Actual Model 3 refresh rate is 57.524 Hz
+; but this can cause judder so we use 60 Hz by default.
+RefreshRate = 60.000
